{
  "name": "@callback/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -b",
    "arch:check": "depcruise src",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run arch:check && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@tanstack/react-query": "^5.106.1",
    "@tanstack/react-router": "^1.170.46",
    "@vega-ui/icons": "^2.5.0",
    "@vega-ui/react": "^2.5.0",
    "@vega-ui/theme-core": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "use-intl": "^4.14.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "^5.1.0",
    "@vitest/browser-playwright": "^5.1.0",
    "config-oxc": "github:callback-work/config-oxc#v0.1.0",
    "dependency-cruiser": "^18.7.2",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "playwright": "^1.65.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vitest-browser-react": "^2.3.0"
  },
  "engines": {
    "node": ">=22"
  }
}
